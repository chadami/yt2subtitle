    "text": "[music]",
    "index": 84
  },
  {
    "start": 467.12,
    "end": 470.18666666666667,
    "text": "I'm just saying like um It's coming.",
    "index": 85
  },
  {
    "start": 470.18666666666667,
    "end": 471.72,
    "text": "You put like that.",
    "index": 86
  },
  {
    "start": 471.72,
