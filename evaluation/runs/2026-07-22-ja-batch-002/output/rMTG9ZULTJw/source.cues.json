    "text": "Open it here.",
    "index": 99
  },
  {
    "start": 490.83178082191785,
    "end": 492,
    "text": "You can adjust the volume.",
    "index": 100
  },
  {
    "start": 492,
    "end": 492.76,
    "text": "Perfecto.",
    "index": 101
  },
  {
    "start": 492.76,
    "end": 493.2,
    "text": "Okay.",
    "index": 102
  },
  {
    "start": 493.2,
    "end": 494.6,
    "text": "Bless you.",
    "index": 103
  },
  {
    "start": 494.6,
    "end": 501.08,
    "text": "I acquired this for my safety and because I dropped my phone earlier and it cracked.",
    "index": 104
  },
  {
    "start": 501.08,
    "end": 504.12,
    "text": "So, you live and learn.",
    "index": 105
  },
  {
    "start": 506.975,
    "end": 508.995,
    "text": "[music]",
    "index": 106
  },
  {
    "start": 513.525,
    "end": 515.545,
    "text": "[music]",
    "index": 107
  },
  {
    "start": 518.4,
    "end": 524.005,
    "text": "Phone holder, city bike, the game is a unstoppable.",
    "index": 108
  },
  {
    "start": 524.005,
    "end": 526.026,
    "text": "[music]",
    "index": 109
  },
  {
    "start": 527.12,
    "end": 530.72,
    "text": "It's so nice.",
    "index": 110
  },
  {
    "start": 531.211,
    "end": 533.231,
    "text": "[music]",
    "index": 111
  },
  {
    "start": 534.44,
    "end": 536.5719480519481,
    "text": "I got completely soaked in the rain.",
    "index": 112
  },
  {
    "start": 536.5719480519481,
    "end": 537.2233766233767,
    "text": "Oh my gosh.",
    "index": 113
  },
  {
    "start": 537.2233766233767,
    "end": 539,
    "text": "It started raining like crazy.",
    "index": 114
  },
  {
    "start": 539,
    "end": 542.2,
    "text": "It was still super nice though.",
    "index": 115
  },
  {
    "start": 546.931,
    "end": 548.951,
    "text": "[music]",
    "index": 116
  },
  {
    "start": 554.791,
