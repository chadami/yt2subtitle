  },
  {
    "start": 737.64,
    "end": 742.48,
    "text": "This is my outfit for the day and I'm ready to head out.",
    "index": 145
  },
  {
    "start": 771.04,
    "end": 775.135,
    "text": "You're coming to Manhattan with me on this thing.",
    "index": 146
  },
  {
    "start": 775.135,
