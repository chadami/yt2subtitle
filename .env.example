# Local development only. The packaged macOS app supplies these settings itself.
PORT=3000
DATA_DIR=.local-data
WORKER_CONCURRENCY=2
# Optional: restrict to a specific Chrome extension origin; * accepts extension origins only.
EXTENSION_ORIGIN=*
# Optional: stable local connection token (at least 24 characters recommended).
# LOCAL_TOKEN=

# AI credentials: managed by Keychain in the macOS app.
LOCAL_AI_PROVIDER=deepseek
LOCAL_AI_API_KEY=
LOCAL_AI_MODEL=deepseek-v4-flash
LOCAL_AI_BASE_URL=

# Machine fallback starts only after the AI job finally fails.
LOCAL_MT_PROVIDER=off
LOCAL_TRANSLATE_HELPER=
GOOGLE_CLOUD_TRANSLATION_API_KEY=
GOOGLE_CLOUD_TRANSLATION_ENDPOINT=https://translation.googleapis.com

# Independent evaluation scripts only.
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
