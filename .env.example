# Backend
NODE_ENV=development
PORT=3000
PUBLIC_APP_URL=http://localhost:3000
EXTENSION_ORIGIN=chrome-extension://YOUR_EXTENSION_ID

# Database / Queue
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE
REDIS_URL=redis://localhost:6379
WORKER_CONCURRENCY=2

# AI providers
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Fast machine-translation fallback shown while AI subtitles are still being generated.
# Leave GOOGLE_CLOUD_TRANSLATION_API_KEY empty to disable this fallback without affecting AI translation.
GOOGLE_CLOUD_TRANSLATION_API_KEY=
GOOGLE_CLOUD_TRANSLATION_ENDPOINT=https://translation.googleapis.com

# Email login
# local = print sign-in codes to logs. resend = send via Resend API.
EMAIL_PROVIDER=resend
EMAIL_FROM=noreply@yt.invisiblewind.cn
RESEND_API_KEY=

# Auth
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password
MAGIC_LINK_TTL_MINUTES=20

# Product defaults
DEFAULT_TARGET_LANG=zh-Hans
